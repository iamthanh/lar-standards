# Canonical editorconfig for every LAR repo.
# SOURCE OF TRUTH: iamthanh/lar-standards :: config/.editorconfig

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.rs]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,json,css,scss}]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

[*.md]
# Markdown uses trailing whitespace for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
